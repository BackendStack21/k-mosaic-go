.vscode/
.idea/
*.swp
*~

# macOS
.DS_Store

# Environment files
.env

# Logs
*.log

# Generated files
*.out

# Ignore compiled packages
*.a

# Ignore temporary files
tmp/

# Keep go.mod and go.sum tracked
# (do not ignore them)

